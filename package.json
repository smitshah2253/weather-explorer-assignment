{
  "name": "weather-explorer-monorepo",
  "version": "1.0.0",
  "description": "Monorepo root for weather-explorer",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && .venv\\Scripts\\activate && uvicorn app.main:app --reload",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && python -m venv .venv && .venv\\Scripts\\activate && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
